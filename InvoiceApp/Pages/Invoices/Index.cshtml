@page
@model InvoiceApp.Pages.Invoices.IndexModel
@{
    ViewData["Title"] = "Invoices";
}

<h2>Invoices</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show text-center mb-4 shadow-sm" role="alert">
        <strong>Harika!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <a class="btn btn-primary" asp-page="/Invoices/Create">Create New Invoice</a>

    <form method="get" class="d-flex align-items-center">
        <label for="pageSize" class="me-2 mb-0 text-nowrap">Sayfa Başına Kayıt:</label>
        <select id="pageSize" name="pageSize" class="form-select form-select-sm" onchange="this.form.submit()">
            <!option value="5" @(Model.PageSize == 5 ? "selected" : "")>5</!option>
            <!option value="10" @(Model.PageSize == 10 ? "selected" : "")>10</!option>
            <!option value="20" @(Model.PageSize == 20 ? "selected" : "")>20</!option>
            <!option value="50" @(Model.PageSize == 50 ? "selected" : "")>50</!option>
        </select>
        <input type="hidden" name="pageIndex" value="1" />
    </form>
</div>

<table class="table align-middle">
    <thead>
        <tr>
            <th>ID</th>
            <th>Invoice Number</th>
            <th>Status</th>
            <th>Customer Name</th>
            <th>Total Price</th>
            <th>Issue Date</th>
            <th>Due Date</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody class="table-group-divider">
        @foreach (var invoice in Model.invoiceList)
        {
            <tr>
                <td>@invoice.Id</td>
                <td>@invoice.Number</td>

                <td>
                    @if (invoice.Status == "Paid")
                    {
                        <span class="badge bg-success px-2 py-1">Paid</span>
                    }
                    else if (invoice.Status == "Pending")
                    {
                        <span class="badge bg-warning text-dark px-2 py-1">Pending</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary px-2 py-1">@invoice.Status</span>
                    }
                </td>
                <td>@invoice.ClientName</td>

                <td class="fw-bold text-primary">
                    @(invoice.Items.Sum(item => item.UnitPrice * item.Quantity).ToString("N2")) $
                </td>

                <td>@invoice.IssueDate</td>
                <td>@invoice.DueDate</td>

                <td style="white-space:nowrap">
                    <a class="btn btn-secondary" asp-page="/Invoices/Edit" asp-route-id="@invoice.Id" asp-route-mode="details">Details</a>
                    <a class="btn btn-primary" asp-page="/Invoices/Edit" asp-route-id="@invoice.Id" asp-route-mode="edit">Edit</a>
                    <a class="btn btn-danger" asp-page="/Invoices/Edit" asp-route-id="@invoice.Id" asp-route-mode="delete">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">

            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link"
                   asp-page="/Invoices/Index"
                   asp-route-pageIndex="@(Model.PageIndex - 1)"
                   asp-route-pageSize="@Model.PageSize">Previous</a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                    <a class="page-link"
                       asp-page="/Invoices/Index"
                       asp-route-pageIndex="@i"
                       asp-route-pageSize="@Model.PageSize">@i</a>
                </li>
            }

            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link"
                   asp-page="/Invoices/Index"
                   asp-route-pageIndex="@(Model.PageIndex + 1)"
                   asp-route-pageSize="@Model.PageSize">Next</a>
            </li>

        </ul>
    </nav>
}